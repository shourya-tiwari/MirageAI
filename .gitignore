# Data and model artefacts are regenerated, never committed.
# The directories themselves are kept so a fresh clone has the right structure.
data/**
!data/**/
!data/**/.gitkeep
outputs/models/**
!outputs/models/.gitkeep
# Out-of-fold predictions (~0.8 GB, over GitHub's 100 MB file limit); rebuilt by
# scripts/pipeline/run_phase4.py, and every metric from them is in the shipped CSVs.
outputs/tables/oof_predictions*.parquet
outputs/tables/_oof_parts*/
outputs/oof/
outputs/cache/
# Built submission package (scripts/make_submission.py)
MirageAI_Final_Submission.zip

# Environments
.venv/
.venv-*/
venv/
env/
.conda/

# Credentials and secrets
.env
*.key
*credentials*
.config/earthengine/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Temporary files (including Office lock files)
~$*
*.tmp
*.bak
*.swp
